{
  "name": "colloquy",
  "version": "1.0.0",
  "type": "module",
  "description": "AI chat in a side panel. Conversations are saved to your vault as markdown notes, and summarised so later ones have the context. Supports Ollama, OpenAI, Anthropic, Google and DeepSeek.",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "test": "node --test *.test.js",
    "gate": "node scripts/gate.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YoItsRdL/colloquy.git"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "ai",
    "llm",
    "ollama",
    "notes"
  ]
}
