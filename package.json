{
  "name": "colloquy",
  "version": "1.0.2",
  "type": "module",
  "description": "Build a knowledge base out of your AI conversations. Each one is saved to your vault as markdown, then summarised so the next starts with the context. Supports Ollama, OpenAI, Anthropic, Google and DeepSeek.",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "test": "node --import ./test/register.mjs --test *.test.js",
    "gate": "node scripts/gate.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YoItsRdL/colloquy.git"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "ai",
    "llm",
    "ollama",
    "notes"
  ]
}
